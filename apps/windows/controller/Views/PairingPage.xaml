<Page x:Class="AppMapper.Controller.Views.PairingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="配对"
      ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
        <StackPanel Margin="24,24,24,24">
            <TextBlock Text="配对" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16" />

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="24">
                <StackPanel>
                    <TextBlock Text="本机地址" FontSize="12" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding ServerAddress}" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,16" />
                    <TextBlock Text="{Binding NetworkWarning}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="#9A6700"
                               Visibility="{Binding HasNetworkWarning, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Margin="0,-8,0,16" />

                    <TextBlock Text="临时连接验证码（每 60 秒刷新）" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding PairingCode}" FontSize="48" FontWeight="Bold" TextAlignment="Center" Margin="0,8,0,16" />
                    <TextBlock Text="扫码记住设备" FontSize="12" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />

                    <Viewbox MaxWidth="296" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center">
                        <Border Background="White" CornerRadius="6" Padding="8">
                            <Image Source="{Binding QrImage}" Width="280" Height="280" Stretch="Uniform" />
                        </Border>
                    </Viewbox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
