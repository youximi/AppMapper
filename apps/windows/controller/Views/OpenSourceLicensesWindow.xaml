<ui:FluentWindow x:Class="AppMapper.Controller.Views.OpenSourceLicensesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="开源许可"
        Width="680" Height="640" MinWidth="440" MinHeight="400"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="开源许可" ShowMinimize="False" ShowMaximize="True" ShowClose="True" />

        <ScrollViewer x:Name="LibraryPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24,16,24,0">
            <StackPanel>
                <TextBlock Text="引用库" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="AppMapper Windows 发行版使用以下开源库。点击条目可查看版本信息和许可全文。"
                                   TextWrapping="Wrap" Margin="0,0,0,12" />
                        <TextBlock x:Name="LibraryCountText" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <WrapPanel>
                            <ui:Button Content="项目许可" Click="OnOpenProjectLicense" Margin="0,0,12,0" />
                            <ui:Button Content="完整声明" Click="OnOpenNotices" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <ItemsControl x:Name="LibraryList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Button Click="OnOpenLibrary" Tag="{Binding}" HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Stretch" Padding="16" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Version}" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding License}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ui:SymbolIcon Grid.Column="1" Symbol="ChevronRight24" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </Grid>
                            </ui:Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="DocumentPanel" Grid.Row="1" Visibility="Collapsed" Margin="24,16,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ui:Button Content="返回库列表" Click="OnBack" Margin="0,0,0,12" />
            <TextBlock x:Name="DocumentTitle" Grid.Row="1" FontSize="24" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,0,0,12" />
            <TextBox x:Name="DocumentText" Grid.Row="2" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     Padding="12" />
        </Grid>

        <ui:Button Grid.Row="2" Content="关闭" Click="OnClose" IsCancel="True"
                   HorizontalAlignment="Right" Margin="24,16,24,16" />
    </Grid>
</ui:FluentWindow>
