<Page x:Class="AppMapper.Controller.Views.DevicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="设备" ScrollViewer.CanContentScroll="False">
    <Grid Margin="24" VerticalAlignment="Top" RowDefinitions="Auto,*">

        <TextBlock Grid.Row="0" Text="设备" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16" />

        <ui:ListView Grid.Row="1" ItemsSource="{Binding Devices}"
                     SelectionMode="Single" HorizontalContentAlignment="Stretch"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ui:ListView.ItemContainerStyle>
                <Style TargetType="{x:Type ui:ListViewItem}" BasedOn="{StaticResource ListViewItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="0,0,0,12" />
                </Style>
            </ui:ListView.ItemContainerStyle>
            <ui:ListView.ItemTemplate>
                <DataTemplate>
                    <ui:Card>
                        <StackPanel>
                            <Grid Margin="0,0,0,20" ColumnDefinitions="Auto,*,Auto">
                                <ui:SymbolIcon Symbol="Phone24" FontSize="24"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Top" Margin="0,2,12,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding DeviceName}" FontSize="16" FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <ui:Badge Appearance="Secondary" HorizontalAlignment="Left" Margin="0,6,0,0"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <TextBlock Text="{Binding State}" FontSize="12" TextWrapping="Wrap" />
                                    </ui:Badge>
                                </StackPanel>
                                <ui:Button Grid.Column="2" Content="移除" Icon="{ui:SymbolIcon Delete24}"
                                           Command="{Binding DataContext.RemoveDeviceCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                           CommandParameter="{Binding}"
                                           VerticalAlignment="Top" Margin="12,0,0,0" />
                            </Grid>

                            <TextBlock Text="当前 App" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,16">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Text" Value="{Binding CurrentApp}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentApp}" Value="">
                                                <Setter Property="Text" Value="无前台应用" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="最后消息" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding LastSeen, StringFormat=\{0:HH:mm:ss\}}" />
                            </Grid>
                        </StackPanel>
                        <ui:Card.Footer>
                            <StackPanel>
                                <TextBlock Text="设备 ID" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding DeviceId}" FontFamily="Consolas" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </ui:Card.Footer>
                    </ui:Card>
                </DataTemplate>
            </ui:ListView.ItemTemplate>
        </ui:ListView>
    </Grid>
</Page>
